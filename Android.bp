    target: {
        host: {
            shared: { srcs: ["host/lib64/libdng_sdk.so"] },
            static: { srcs: ["host/lib64/libdng_sdk.a"] },
        },
        android: {
            shared: { srcs: ["target/lib64/libdng_sdk.so"] },
            static: { srcs: ["target/lib64/libdng_sdk.a"] },
        },
    },
}

cc_prebuilt_library_static {
    name: "libdng_sdk_validate",
    vendor_available: true,
    product_available: true,
    export_include_dirs: [
        "include",
        "include/dng_sdk",
    ],
    srcs: ["target/lib64/libdng_sdk_validate.a"],
